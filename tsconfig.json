{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "node16",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "ts-node": {
    "files": true
  },
  "include": ["src"]
}
